  "patterns": [
    {
      "match": "^You are now combat level ([0-9]+)!?$",
      "replace": "你現在的戰鬥等級為 $1!"
    },
    {
      "match": "^(.+) has thrown an? (.+) Bomb on (.+)$",
      "replace": "$1 在 $3 使用了{lookup:$2}炸彈"
    },
    {
      "match": "^(\\[!\\] )?Congratulations to (.+) for reaching combat level ([0-9]+)!$",
      "replace": "$1恭喜 $2 戰鬥等級達到 $3 級!"
    },
    {
      "match": "^Combat Lv\\. Min: ([0-9]+)$",
      "replace": "戰鬥等級需求:$1"
    },
    {
      "match": "^(Strength|Dexterity|Intelligence|Defence|Agility) Min: ([0-9]+)$",
      "replace": "{lookup:$1}需求:$2"
    },
    {
      "match": "^Class Req: (.+)$",
      "replace": "職業需求:{lookup:$1}"
    },
    {
      "match": "^Quest Req: (.+)$",
      "replace": "前置任務:$1"
    },
    {
      "match": "^Press (SHIFT|SNEAK) to continue$",
      "replace": "按 SHIFT 繼續"
    },
    {
      "match": "^Unassigned Skill Points: ([0-9]+)$",
      "replace": "未分配技能點:$1"
    },
    {
      "match": "^([0-9]+(?:\\.[0-9]+)?)s$",
      "replace": "$1秒"
    },
    {
      "match": "^([0-9]+(?:\\.[0-9]+)?) ?mins?$",
      "replace": "$1分"
    },
    {
      "match": "^([0-9]+(?:\\.[0-9]+)?) Blocks? \\(Circle-Shaped\\)$",
      "replace": "$1 格(圓形)"
    },
    {
      "match": "^\\(([0-9]+) Blocks?\\)$",
      "replace": "($1 格)"
    },
    {
      "match": "^(.*?)Unused Ability Points: ([0-9]+)$",
      "replace": "$1未使用能力點:$2"
    },
    {
      "match": "^(.+?) is now level ([0-9]+)!?$",
      "replace": "$1 現在是 $2 級"
    },
    {
      "match": "^(.+?) is now combat level ([0-9]+)!?$",
      "replace": "$1 現在是戰鬥等級 $2"
    },
    {
      "match": "^One more level to reach (.+)$",
      "replace": "再升一級即可達到 $1"
    },
    {
      "match": "^Sold ([0-9,]+) items? for (.+)$",
      "replace": "賣出 $1 項,獲得 $2"
    },
    {
      "match": "^You have ([0-9]+) unused skill points?$",
      "replace": "你有 $1 點未使用的技能點"
    },
    {
      "match": "^You have ([0-9]+) unused ability points?$",
      "replace": "你有 $1 點未使用的能力點"
    },
    {
      "match": "^\\(([0-9]+)m ?([0-9]+)s\\)$",
      "replace": "(剩 $1分$2秒)"
    },
    {
      "match": "^\\(([0-9]+)s\\)$",
      "replace": "(剩 $1秒)"
    },
    {
      "match": "^\\(([0-9]+)m\\)$",
      "replace": "(剩 $1分)"
    },
    {
      "match": "^on ([A-Za-z]{2,3}[0-9]{1,3}) \\(([0-9]+)m ?([0-9]+)s\\)$",
      "replace": "於 $1(剩 $2分$3秒)"
    },
    {
      "match": "^on ([A-Za-z]{2,3}[0-9]{1,3}) \\((.+)\\)$",
      "replace": "於 $1($2)"
    },
    {
      "match": "^([0-9]+)m ?([0-9]+)s$",
      "replace": "$1分$2秒"
    },
    {
      "match": "^([0-9]+)m$",
      "replace": "$1分"
    },
    {
      "match": "^([A-Za-z][A-Za-z '/]*[A-Za-z]) ([+-][0-9].*)$",
      "replace": "{lookup:$1} $2",
      "requireLookup": true
    },
    {
      "match": "^([A-Za-z][A-Za-z '/]*[A-Za-z]): ?([+-]?[0-9].*)$",
      "replace": "{lookup:$1}:$2",
      "requireLookup": true
    },
    {
      "match": "^\\[([0-9]+)/([0-9]+)\\] ([^:]+): (.+)$",
      "replace": "[$1/$2] $3:{lookup:$4}",
      "requireLookup": true
    },
    {
      "match": "^([A-Za-z]+) Scythe$",
      "replace": "{lookup:$1}鐮刀",
      "requireLookup": true
    },
    {
      "match": "^([A-Za-z]+) Axe$",
      "replace": "{lookup:$1}斧",
      "requireLookup": true
    },
    {
      "match": "^([A-Za-z]+) Pickaxe$",
      "replace": "{lookup:$1}十字鎬",
      "requireLookup": true
    },
    {
      "match": "^([A-Za-z]+) Rod$",
      "replace": "{lookup:$1}釣竿",
      "requireLookup": true
    }
  ]
}
